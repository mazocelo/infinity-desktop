{
  "name": "infinity-desktop",
  "version": "1.1.0",
  "description": "Infinity Desktop - casca Electron que abre o site do Infinity com bandeja, notificação nativa, auto-start e links infinity://",
  "author": "Voxcity <contato@voxcity.com.br>",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:frontend": "cd ../infinity-frontend && npm run dev",
    "dev:all": "npm run dev:frontend & sleep 3 && npm run dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config",
    "build:dir": "npm run build && electron-builder --win --dir --config",
    "sync-audit": "npx tsx scripts/sync-audit.ts",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "test": "vitest run"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@swc/core": "^1.15.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
